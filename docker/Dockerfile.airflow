FROM apache/airflow:2.8.3-python3.11

COPY docker/requirements-airflow.txt /requirements-airflow.txt

# Installation via le fichier de contraintes officiel Airflow 2.8.3 / Python 3.11
# -> évite les conflits de versions qui cassent le logging Airflow (handler "processor")
RUN pip install --no-cache-dir \
    --constraint "https://raw.githubusercontent.com/apache/airflow/constraints-2.8.3/constraints-3.11.txt" \
    -r /requirements-airflow.txt
